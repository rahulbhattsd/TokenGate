generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [vector]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  apiKeys   ApiKey[]
  createdAt DateTime @default(now())
}

model ApiKey {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  keyHash    String   @unique
  label      String
  revoked    Boolean  @default(false)
  requests   RequestLog[]
  cacheEntries CacheEntry[]
  createdAt  DateTime @default(now())
}

model RequestLog {
  id            String   @id @default(uuid())
  apiKeyId      String
  apiKey        ApiKey   @relation(fields: [apiKeyId], references: [id])
  provider      String
  model         String
  inputTokens   Int
  outputTokens  Int
  tokensSaved   Int      @default(0)
  cachedHit     Boolean  @default(false)
  costUsd       Float
  latencyMs     Int
  purpose       String?
  createdAt     DateTime @default(now())
}

model CacheEntry {
  id          String                       @id @default(uuid())
  promptHash  String
  embedding   Unsupported("vector(1536)")
  response    String
  provider    String
  model       String
  inputTokens Int      @default(0)
  outputTokens Int     @default(0)
  hitCount    Int      @default(0)
  apiKeyId    String
  apiKey      ApiKey   @relation(fields: [apiKeyId], references: [id])
  createdAt   DateTime @default(now())

  @@unique([promptHash, apiKeyId])
}
